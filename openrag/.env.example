# Application Settings
APP_NAME=OpenRag
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8001

# PostgreSQL（与 openrag.config.PostgresConfig 一致；应用不读取 DB_*）
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=openrag
POSTGRES_PASSWORD=openrag_pass
POSTGRES_DATABASE=openrag

# 文档解析由 Task Worker 执行（见 LOCAL_DEV_GUIDE.md；非 Celery）

# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_RUNTIME_USER=
MILVUS_RUNTIME_PASSWORD=
MILVUS_INDEX_ADMIN_USER=
MILVUS_INDEX_ADMIN_PASSWORD=
# Only export these for the explicit index_cleanup CLI/Job, never API/Worker.
MILVUS_CLEANUP_USER=
MILVUS_CLEANUP_PASSWORD=

# Elasticsearch 全文索引（可选；与 docker-compose 中 elasticsearch 服务配合）
ELASTICSEARCH__ENABLED=false
ELASTICSEARCH__HOSTS=http://localhost:9200
ELASTICSEARCH__VERIFY_CERTS=false
# Selects the retrieval path. independent_rrf requires Elasticsearch.
ELASTICSEARCH__HYBRID_RECALL_MODE=legacy
# Selects only the ES write target. v2_alias also requires a completed A02 migration.
# When Elasticsearch is enabled, document ingestion requires a complete ES chunk write.
ELASTICSEARCH__CHUNK_INDEX_MODE=legacy

# Authentication & Security
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MinIO / 对象存储（与 openrag.config.StorageConfig 对应，前缀 STORAGE_）
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
# 浏览器或前端拼接对象 URL 时使用；不设置则用 http(s)://STORAGE_ENDPOINT
STORAGE_PUBLIC_URL=http://localhost:9000

# LLM 网关（litellm，OpenAI 兼容；对齐 k8s / docker）：Embedding 入库+检索，L1 导航复用同一网关
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=http://litellm.guozhijishu.com/v1
EMBEDDING_MODEL=Qwen3-Embedding-4B
EMBEDDING_DIMENSION=2560
EMBEDDING_REVISION=Qwen3-Embedding-4B
EMBEDDING_MODEL_IDENTITY=Qwen3-Embedding-4B
EMBEDDING_NORMALIZATION=none
EMBEDDING_INPUT_TYPE=text
EMBEDDING_ENCODING_FORMAT=float
EMBEDDING_DISTANCE_METRIC=COSINE
EMBEDDING_QUERY_PREFIX_REVISION=none
EMBEDDING_DOCUMENT_PREFIX_REVISION=none
EMBEDDING_TEXT_PREPROCESS_REVISION=v1
EMBEDDING_SDK_CONTRACT_REVISION=openai-v1
EMBEDDING_CONFIG_REF=embedding/default
L1_NAV_MODEL=DeepSeek-V4-Flash
# OPENRAG_RETRIEVAL_USE_L0_L1=false

# File Upload Configuration
MAX_UPLOAD_SIZE=104857600
UPLOAD_DIR=./uploads

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8001

# Candidate quality and internal shadow search (shadow disabled by default)
INDEX_QUALITY_RECALL_MAX_REGRESSION=0.02
INDEX_QUALITY_NDCG_MAX_REGRESSION=0.02
INDEX_QUALITY_MRR_MAX_REGRESSION=0.02
INDEX_QUALITY_P95_MAX_REGRESSION=0.20
INDEX_SHADOW_SAMPLE_RATE=0.0
INDEX_SHADOW_BUDGET_MS=100
