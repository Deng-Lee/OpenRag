# Multi-stage build for OpenRag Frontend
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files
COPY web/package*.json ./

# Install dependencies required by the frontend build.
ARG NPM_REGISTRY=https://registry.npmjs.org
ARG NPM_PROXY=
RUN npm config set registry "${NPM_REGISTRY}" \
    && if [ -n "${NPM_PROXY}" ]; then \
        npm config set proxy "${NPM_PROXY}" \
        && npm config set https-proxy "${NPM_PROXY}"; \
      elif wget -q -T 2 -O /dev/null http://http.docker.internal:3128; then \
        npm config set proxy http://http.docker.internal:3128 \
        && npm config set https-proxy http://http.docker.internal:3128; \
      fi \
    && npm ci --include=dev --include=optional \
    && npm ls typescript vite --depth=0 \
    && ls -la node_modules/.bin/tsc node_modules/.bin/vite

# Copy source code
COPY web/ .

# Build the application
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration template
COPY docker/nginx/nginx.conf /etc/nginx/templates/nginx.conf.template

ENV NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx
ENV PREVIEW_FRAME_ANCESTORS="'self' http://192.168.100.33:2026 http://192.168.100.32:2026 http://172.16.31.61:2026 http://172.16.31.156:2026"

# Expose port
EXPOSE 80

# Health check
# 用 127.0.0.1 而非 localhost：容器内 localhost 会先解析成 IPv6 [::1]，
# 而 nginx 仅监听 IPv4，会导致探针 Connection refused → 容器误报 unhealthy。
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/health || exit 1

CMD ["sh", "-c", "envsubst '${PREVIEW_FRAME_ANCESTORS}' < /etc/nginx/templates/nginx.conf.template > /etc/nginx/nginx.conf && exec nginx -g 'daemon off;'"]
