# Production Environment Variables
# Copy this file to .env and update with your production values

# PostgreSQL Configuration（与 openrag.config.PostgresConfig / POSTGRES_* 一致）
POSTGRES_PASSWORD=change_this_secure_password_in_production
POSTGRES_USER=openrag
POSTGRES_DB=openrag

# MinIO Configuration (for Milvus)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_minio_password

# Application Security
SECRET_KEY=change_this_to_a_random_secret_key_at_least_32_characters_long

# CORS Configuration
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8001

# Web Port (default: 80)
WEB_PORT=80

# LLM 网关（litellm，OpenAI 兼容）：Embedding 入库+检索，L1 导航复用同一网关
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=http://litellm.guozhijishu.com/v1
RERANKER_PROVIDER=litellm
RERANKER_MODEL=Qwen3-VL-Reranker-8B
RERANKER_BASE_URL=http://litellm.guozhijishu.com/rerank
RERANKER_API_KEY=
RERANKER_MAX_DOCUMENTS=100
EMBEDDING_MODEL=Qwen3-Embedding-4B
EMBEDDING_DIMENSION=2560
EMBEDDING_REVISION=Qwen3-Embedding-4B
EMBEDDING_MODEL_IDENTITY=Qwen3-Embedding-4B
EMBEDDING_NORMALIZATION=none
EMBEDDING_INPUT_TYPE=text
EMBEDDING_ENCODING_FORMAT=float
EMBEDDING_DISTANCE_METRIC=COSINE
EMBEDDING_QUERY_PREFIX_REVISION=none
EMBEDDING_DOCUMENT_PREFIX_REVISION=none
EMBEDDING_TEXT_PREPROCESS_REVISION=v1
EMBEDDING_SDK_CONTRACT_REVISION=openai-v1
EMBEDDING_CONFIG_REF=embedding/default
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_PROBE_INTERVAL_SECONDS=30
# L1 导航 LLM（留空 KEY/BASE_URL 回退到 OPENAI_*）
L1_NAV_MODEL=youfu/Qwen3.6-35B-A3B

# Retrieval-time L0/L1 usage. Set false to produce L0/L1 artifacts but make recall use flat L2 chunks only.
OPENRAG_RETRIEVAL_USE_L0_L1=false

# Milvus Vector Database
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_RUNTIME_USER=
MILVUS_RUNTIME_PASSWORD=
MILVUS_INDEX_ADMIN_USER=
MILVUS_INDEX_ADMIN_PASSWORD=
# Only inject into a controlled cleanup Job.
MILVUS_CLEANUP_USER=
MILVUS_CLEANUP_PASSWORD=

# Elasticsearch（docker-compose.prod / dev 会启动本服务；compose 内默认 HOST 为 http://elasticsearch:9200）
ELASTICSEARCH_PORT=9200
ELASTICSEARCH__ENABLED=true
# 若 API 在宿主机运行、仅 ES 在 Docker，可取消下行注释：
# ELASTICSEARCH__HOSTS=http://localhost:9200
ELASTICSEARCH__VERIFY_CERTS=false

# Hierarchy Storage (local filesystem path)
HIERARCHY_STORAGE_PATH=./storage/hierarchies

# PDF parser backend for worker: ragflow (DeepDoc) or pymupdf
OPENRAG_PDF_BACKEND=ragflow

# Candidate quality and internal shadow search (shadow disabled by default)
INDEX_QUALITY_RECALL_MAX_REGRESSION=0.02
INDEX_QUALITY_NDCG_MAX_REGRESSION=0.02
INDEX_QUALITY_MRR_MAX_REGRESSION=0.02
INDEX_QUALITY_P95_MAX_REGRESSION=0.20
INDEX_SHADOW_SAMPLE_RATE=0.0
INDEX_SHADOW_BUDGET_MS=100

# PaddleOCR server URL used by task-worker. Set per deployment environment.
# PADDLEOCR_SERVER_URL=http://your-paddleocr-server
