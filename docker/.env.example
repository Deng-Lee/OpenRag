# Production Environment Variables
# Copy this file to .env and update with your production values

# PostgreSQL Configuration（与 openrag.config.PostgresConfig / POSTGRES_* 一致）
POSTGRES_PASSWORD=change_this_secure_password_in_production
POSTGRES_USER=openrag
POSTGRES_DB=openrag

# MinIO Configuration (for Milvus)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_this_minio_password

# Application Security
SECRET_KEY=change_this_to_a_random_secret_key_at_least_32_characters_long

# CORS Configuration
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8001

# Web Port (default: 80)
WEB_PORT=80

# OpenAI Embedding
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Milvus Vector Database
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Elasticsearch（docker-compose.prod / dev 会启动本服务；compose 内默认 HOST 为 http://elasticsearch:9200）
ELASTICSEARCH_PORT=9200
ELASTICSEARCH__ENABLED=true
# 若 API 在宿主机运行、仅 ES 在 Docker，可取消下行注释：
# ELASTICSEARCH__HOSTS=http://localhost:9200
ELASTICSEARCH__VERIFY_CERTS=false

# Hierarchy Storage (local filesystem path)
HIERARCHY_STORAGE_PATH=./storage/hierarchies

# PDF parser backend for worker: ragflow (DeepDoc) or pymupdf
OPENRAG_PDF_BACKEND=ragflow

