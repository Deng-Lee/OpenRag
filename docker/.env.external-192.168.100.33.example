# External Docker Compose environment for 192.168.100.33.
# Copy to docker/.env.external-192.168.100.33 and fill secrets before deployment.

# PostgreSQL
POSTGRES_PASSWORD=<强密码>
POSTGRES_USER=openrag
POSTGRES_DB=openrag

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=<强密码>

# Application security
SECRET_KEY=<32位以上随机字符串>

# External web/API runtime
WEB_PORT=80
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8001

# Preview links for external iframe integration
PREVIEW_PUBLIC_WEB_BASE_URL=http://192.168.100.33
PREVIEW_FRAME_ANCESTORS="'self' http://192.168.100.32:2026 http://192.168.100.33:2026"
PREVIEW_TOKEN_TTL_SECONDS=900
PREVIEW_TOKEN_MAX_TTL_SECONDS=1800

# LLM gateway
OPENAI_API_KEY=<模型网关或OpenAI兼容接口key>
OPENAI_BASE_URL=<模型网关或OpenAI兼容接口地址>
EMBEDDING_MODEL=<实际embedding模型>
EMBEDDING_DIMENSION=<实际embedding维度>
EMBEDDING_REVISION=<与EMBEDDING_MODEL一致>
EMBEDDING_MODEL_IDENTITY=<与EMBEDDING_MODEL一致>
L1_NAV_MODEL=DeepSeek-V4-Flash

# Retrieval
OPENRAG_RETRIEVAL_USE_L0_L1=false

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH__ENABLED=true
ELASTICSEARCH__HOSTS=http://elasticsearch:9200
ELASTICSEARCH__VERIFY_CERTS=false
# independent_rrf requires Elasticsearch; CHUNK_INDEX_MODE only selects the ES target.
# With Elasticsearch enabled, document ingestion fails closed on incomplete ES writes.
ELASTICSEARCH__HYBRID_RECALL_MODE=legacy
ELASTICSEARCH__CHUNK_INDEX_MODE=legacy

# Hierarchy storage
HIERARCHY_STORAGE_PATH=./storage/hierarchies

# PDF parser backend for worker: ragflow (DeepDoc) or pymupdf
OPENRAG_PDF_BACKEND=ragflow

# PaddleOCR server URL used by task-worker.
# Example value for this environment only; inject the real URL per deployment.
PADDLEOCR_SERVER_URL=http://litellm.guozhijishu.com
