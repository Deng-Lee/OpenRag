# Dockerfile for OpenRag Task Worker
FROM python:3.11-slim AS builder

WORKDIR /app

ARG BUILD_PROXY=

RUN proxy="${BUILD_PROXY}" \
    && if [ -z "${proxy}" ] && python -c "import socket; socket.create_connection(('http.docker.internal', 3128), 2).close()" 2>/dev/null; then \
        proxy="http://http.docker.internal:3128"; \
      fi \
    && if [ -n "${proxy}" ]; then \
        printf 'Acquire::http::Proxy "%s";\nAcquire::https::Proxy "%s";\n' "${proxy}" "${proxy}" > /etc/apt/apt.conf.d/99build-proxy \
        && printf '[global]\nproxy = %s\n' "${proxy}" > /etc/pip.conf; \
      fi \
    && apt-get update -o Acquire::Retries=5 && apt-get install -y --no-install-recommends \
    -o Acquire::Retries=5 \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

COPY openrag/requirements.txt openrag/requirements-worker.txt ./
RUN pip install --no-cache-dir --user -r requirements.txt -r requirements-worker.txt

FROM python:3.11-slim

WORKDIR /app

ARG BUILD_PROXY=

RUN proxy="${BUILD_PROXY}" \
    && if [ -z "${proxy}" ] && python -c "import socket; socket.create_connection(('http.docker.internal', 3128), 2).close()" 2>/dev/null; then \
        proxy="http://http.docker.internal:3128"; \
      fi \
    && if [ -n "${proxy}" ]; then \
        printf 'Acquire::http::Proxy "%s";\nAcquire::https::Proxy "%s";\n' "${proxy}" "${proxy}" > /etc/apt/apt.conf.d/99build-proxy \
        && printf '[global]\nproxy = %s\n' "${proxy}" > /etc/pip.conf; \
      fi \
    && apt-get update -o Acquire::Retries=5 && apt-get install -y --no-install-recommends \
    -o Acquire::Retries=5 \
    curl \
    tini \
    libreoffice-writer-nogui \
    libreoffice-impress-nogui \
    && rm -rf /var/lib/apt/lists/*

RUN proxy="${BUILD_PROXY}" \
    && if [ -z "${proxy}" ] && python -c "import socket; socket.create_connection(('http.docker.internal', 3128), 2).close()" 2>/dev/null; then \
        proxy="http://http.docker.internal:3128"; \
      fi \
    && if [ -n "${proxy}" ]; then \
        printf 'Acquire::http::Proxy "%s";\nAcquire::https::Proxy "%s";\n' "${proxy}" "${proxy}" > /etc/apt/apt.conf.d/99build-proxy; \
      fi \
    && apt-get update -o Acquire::Retries=5 && apt-get install -y --no-install-recommends \
    -o Acquire::Retries=5 \
    libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /root/.local /root/.local
RUN cp -a /root/.local/lib/python3.11/site-packages/. /usr/local/lib/python3.11/site-packages/ \
    && rm -rf /root/.local

COPY openrag/src/ ./src/
COPY openrag/rag/res/deepdoc/ ./rag/res/deepdoc/
COPY openrag/run_api.py .
COPY openrag/setup.py .
COPY openrag/scripts/verify_worker_ragflow_bundle.py ./scripts/
COPY openrag/scripts/prepare_ragflow_models.py ./scripts/

ENV TIKTOKEN_CACHE_DIR=/app/tiktoken-cache
COPY docker/tiktoken-cache/cl100k_base.tiktoken /app/tiktoken-cache/9b5ad71b2ce5302211f9c61530b329a4922fc6a4

RUN pip install --no-cache-dir -e .

# Fail at build time instead of silently falling back to whitespace token counts.
RUN python - <<'PY'
from common.token_utils import _get_encoder, num_tokens_from_string

encoder = _get_encoder()
if encoder is None:
    raise SystemExit("cl100k_base encoding is unavailable")

sample = "银行间黄金询价业务交易确认细则"
token_count = num_tokens_from_string(sample)
if token_count <= len(sample.split()):
    raise SystemExit("cl100k_base Chinese token check failed")
print(f"cl100k_base offline cache OK: {token_count} tokens")
PY

# Fail fast at build time if offline model bundle is incomplete.
RUN python - <<'PY'
from pathlib import Path
required = [
    "det.onnx",
    "rec.onnx",
    "ocr.res",
    "layout.onnx",
    "tsr.onnx",
    "updown_concat_xgb.model",
]
base = Path("/app/rag/res/deepdoc")
missing = [name for name in required if not (base / name).exists()]
if missing:
    raise SystemExit(
        "Missing offline ragflow model files under /app/rag/res/deepdoc: "
        + ", ".join(missing)
        + ". Run: python openrag/scripts/prepare_ragflow_models.py"
    )
print("offline ragflow model bundle OK")
PY

# 与生产 ragflow 模式一致：强制加载 RAGFlowPdfParser 全链（曾仅用 lazy_image 单测仍漏 ensure_pil_image 等）。
RUN python scripts/verify_worker_ragflow_bundle.py \
    && python -c "import openrag.worker.task_worker; print('task_worker OK')"

RUN useradd -m -u 1000 openrag && chown -R openrag:openrag /app
USER openrag

ENV WORKER_NUM=4
ENV WORKER_PREFIX=worker
ENV WORKER_API_URL=http://api:8000
ENV WORKER_BATCH_SIZE=5
ENV WORKER_POLL_INTERVAL=5

ENTRYPOINT ["tini", "--"]
CMD ["python", "-m", "openrag.worker.task_worker"]
