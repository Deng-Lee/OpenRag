# Production Environment Variables
# Copy this file to .env and update with your production values
# Model / chunking shared settings
# LLM 网关（litellm，OpenAI 兼容）：Embedding 入库+检索，L1 导航复用同一网关（对齐 k8s）
OPENAI_API_KEY=sk-_aevKQ9-EiAsgdEKzeuLvA
OPENAI_BASE_URL=http://litellm.guozhijishu.com/v1
EMBEDDING_MODEL=Qwen3-Embedding-4B
EMBEDDING_DIMENSION=2560

# 当前代码里的 LLM 模型变量名是 L1_NAV_MODEL，不是 LLM_MODEL。
# L1 导航与 Embedding 复用同一个 litellm 网关：留空 L1_NAV_API_KEY / L1_NAV_BASE_URL
# 即回退到 OPENAI_API_KEY / OPENAI_BASE_URL（对齐 k8s）。
L1_NAV_MODEL=DeepSeek-V4-Flash
L1_NAV_API_KEY=
L1_NAV_BASE_URL=

# Reranker：对齐 k8s，不配置外部 reranker（未设置 RERANKER_PROVIDER 时代码默认 local）。

OPENRAG_CHUNK_SIZE=600
OPENRAG_CHUNK_OVERLAP=80
OPENRAG_MIN_CHUNK_TOKENS=32
OPENRAG_RETRIEVAL_USE_L0_L1=false


ELASTICSEARCH__ENABLED=true
# 全 Docker 部署必须用 compose 服务名 elasticsearch；容器内 localhost 指向容器自身，
# 会导致 worker 写索引、api 做 BM25 检索都连不上 ES（仅「API 跑宿主机、只有 ES 在 Docker」时才用 localhost）。
ELASTICSEARCH__HOSTS=http://elasticsearch:9200


# PostgreSQL Configuration
POSTGRES_PASSWORD=openrag_postgres_password_2024
POSTGRES_USER=openrag
POSTGRES_DB=openrag

# MinIO Configuration (for Milvus)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=openrag_minio_password_2024

# Application Security
SECRET_KEY=openrag_jwt_secret_key_min_32_chars_2024_secure_random_string

# CORS Configuration
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8001

# Web Port (default: 80)
WEB_PORT=80

# PDF parser backend for worker: ragflow (DeepDoc) or pymupdf
OPENRAG_PDF_BACKEND=ragflow
