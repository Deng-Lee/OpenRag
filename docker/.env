# Production Environment Variables
# Copy this file to .env and update with your production values
# Model / chunking shared settings
OPENAI_API_KEY=sk-53d4a09e55e14544bbbf96b8aa9dff86
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024

# 当前代码里的 LLM 模型变量名是 L1_NAV_MODEL，不是 LLM_MODEL
L1_NAV_MODEL=deepseek-v4-flash
# L1 LLM can use a different OpenAI-compatible endpoint from embeddings.
# Leave these empty to fall back to OPENAI_API_KEY / OPENAI_BASE_URL.
L1_NAV_API_KEY=sk-7bff4b2132ea48aebafc5fd6890bda78
L1_NAV_BASE_URL=https://api.deepseek.com

# API reranker provider for external DashScope qwen3-vl-rerank
RERANKER_PROVIDER=dashscope
RERANKER_MODEL=qwen3-vl-rerank
RERANKER_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANKER_PAYLOAD_FORMAT=vl
RERANKER_MAX_DOCUMENTS=100
RERANKER_TIMEOUT=30

OPENRAG_CHUNK_SIZE=1000
OPENRAG_CHUNK_OVERLAP=150
OPENRAG_MIN_CHUNK_TOKENS=32
OPENRAG_RETRIEVAL_USE_L0_L1=false


ELASTICSEARCH__ENABLED=true
ELASTICSEARCH__HOSTS=http://localhost:9200


# PostgreSQL Configuration
POSTGRES_PASSWORD=openrag_postgres_password_2024
POSTGRES_USER=openrag
POSTGRES_DB=openrag

# MinIO Configuration (for Milvus)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=openrag_minio_password_2024

# Application Security
SECRET_KEY=openrag_jwt_secret_key_min_32_chars_2024_secure_random_string

# CORS Configuration
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://localhost:8001

# Web Port (default: 80)
WEB_PORT=80

# PDF parser backend for worker: ragflow (DeepDoc) or pymupdf
OPENRAG_PDF_BACKEND=ragflow
