# Python
**/venv/
**/__pycache__/
**/*.pyc
**/*.pyo
**/.eggs/
**/*.egg-info/

# Node
**/node_modules/
**/dist/

# Git
.git/
.gitignore

# IDE & Editor
.vscode/
.idea/

# Claude
.claude/

# Environment
**/.env
**/.env.*

# Uploads & runtime
**/uploads/
**/data/
**/logs/

# Docs & plans (not needed in images)
docs/
*.md
!docker/**/*.md

# Tests
**/tests/
**/test/
**/fixtures/

# Worktrees & build caches (not needed in images; bloat build context)
.worktrees/
**/.uv-cache*/
**/.venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Misc
*.tar
*.tar.gz
*.zip
